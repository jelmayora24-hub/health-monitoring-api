# Environment file untuk konfigurasi
# Bisa diisi dengan konfigurasi sesuai kebutuhan

# Database
DATABASE_PATH=monitoring_kesehatan.db

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS
CORS_ORIGINS=["*"]

# API
API_TITLE=Aplikasi Monitoring Kesehatan
API_VERSION=1.0.0

# Alert thresholds
MIN_HEART_RATE_NORMAL=60
MAX_HEART_RATE_NORMAL=100
MIN_HEART_RATE_WARNING=50
MIN_HEART_RATE_CRITICAL=50
MAX_HEART_RATE_CRITICAL=100
